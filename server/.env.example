# Copiar a .env y completar con los valores reales (nunca commitear .env).

# MongoDB Atlas (en producción, guardar en Secret Manager).
MONGO_URI=

# Meta for Developers > tu app > WhatsApp > API Setup:
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v26.0

# Cualquier string que tú inventes; el mismo valor se pega en la configuración
# del webhook en Meta (campo "Verify token").
WHATSAPP_VERIFY_TOKEN=

# Números autorizados a hablar con el agente, en formato internacional sin "+"
# y separados por coma (ej. "573001234567,573009876543"). Vacío = nadie autorizado.
WHATSAPP_NUMEROS_AUTORIZADOS=

# Socios que aceptaron recibir resúmenes y alertas automáticas. Si se omite,
# se usa WHATSAPP_NUMEROS_AUTORIZADOS.
WHATSAPP_NUMEROS_NOTIFICACIONES=

# Notificaciones de ocupación (zona horaria America/Bogota).
WHATSAPP_OBJETIVO_OCUPACION=75
WHATSAPP_HORA_RESUMEN=07:00
WHATSAPP_HORAS_ALERTA=11:00,15:00,18:00
WHATSAPP_HORA_ALERTA_LLEGADAS=18:00

# Los nombres y el idioma deben coincidir exactamente con las plantillas
# aprobadas en WhatsApp Manager.
WHATSAPP_PLANTILLAS_IDIOMA=es_CO
WHATSAPP_PLANTILLA_RESUMEN=resumen_ocupacion_diaria_po
WHATSAPP_PLANTILLA_RESUMEN_IDIOMA=es_CO
WHATSAPP_PLANTILLA_ALERTA=alerta_ocupacion_baja
WHATSAPP_PLANTILLA_ALERTA_IDIOMA=es_CO
WHATSAPP_PLANTILLA_OBJETIVO=objetivo_ocupacion_alcanzado_po
WHATSAPP_PLANTILLA_OBJETIVO_IDIOMA=es_CO
WHATSAPP_PLANTILLA_LLEGADAS=alerta_llegadas_pendientes_po
WHATSAPP_PLANTILLA_LLEGADAS_IDIOMA=es_CO

# Claude Console > Settings > API keys. En producción, guardar en Secret Manager.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Incluye el razonamiento interno y el texto final. Rango aceptado: 256-4096.
ANTHROPIC_MAX_TOKENS=3000
# Tiempo máximo por llamada a Claude. Rango aceptado: 5000-120000 ms.
ANTHROPIC_TIMEOUT_MS=45000

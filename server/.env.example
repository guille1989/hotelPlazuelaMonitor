# Copiar a .env y completar con los valores reales (nunca commitear .env).

# MongoDB Atlas (en producción, guardar en Secret Manager).
MONGO_URI=

# Meta for Developers > tu app > WhatsApp > API Setup:
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v26.0

# Cualquier string que tú inventes; el mismo valor se pega en la configuración
# del webhook en Meta (campo "Verify token").
WHATSAPP_VERIFY_TOKEN=

# Números autorizados a hablar con el agente, en formato internacional sin "+"
# y separados por coma (ej. "573001234567,573009876543"). Vacío = nadie autorizado.
WHATSAPP_NUMEROS_AUTORIZADOS=

# Claude Console > Settings > API keys. En producción, guardar en Secret Manager.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
